DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yc_launch_monitor?schema=public"
PORT="3000"
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
POLL_INTERVAL_HOURS="8"
EARLY_SIGNAL_CONFIDENCE_THRESHOLD="0.85"
RUN_ON_BOOT="false"
ENABLE_DEMO_MODE="true"
YC_DIRECTORY_URL="https://www.ycombinator.com/companies"
YC_DIRECTORY_BATCHES="S26,W26"
YC_SPEEDRUN_URL="https://www.ycombinator.com/companies?tags=YC%20Speedrun"
X_BEARER_TOKEN=""
ENABLE_X_SOURCE="false"
X_QUERIES="(\"YC S26\" OR \"Y Combinator\") -is:retweet -is:reply||(\"accepted into YC\" OR \"got into YC\") -is:retweet||(\"Speedrun\" \"YC\") -is:retweet||(\"backed by Y Combinator\") -is:retweet"
LINKEDIN_ENABLED="false"
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_POSTS_ENDPOINT=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
SLACK_WEBHOOK_URL=""
LLM_PROVIDER="groq"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
POND_BEARER_TOKEN=""
