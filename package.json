{
  "name": "yc-launch-monitor",
  "version": "0.1.0",
  "description": "Persistent monitor for YC, Speedrun, and founder-announced early YC signals.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "demo:reset": "tsx scripts/reset-demo-data.ts",
    "demo:run": "tsx scripts/test-demo-run.ts",
    "slack:test": "tsx scripts/test-slack.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nehaprasad-dev/yc-launch-monitor.git"
  },
  "keywords": [
    "yc",
    "monitoring",
    "slack",
    "postgres",
    "pond"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nehaprasad-dev/yc-launch-monitor/issues"
  },
  "homepage": "https://github.com/nehaprasad-dev/yc-launch-monitor#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
